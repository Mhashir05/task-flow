# Firebase web app config.
# Copy this file to `.env` and fill in the values from the Firebase console:
#   Project settings -> Your apps -> SDK setup and configuration.
# `.env` is gitignored; this example file is committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed to run scripts/seed-dummy-data.mjs (the one-time dev/testing
# seed script, invoked via `npm run seed:dummy`) — not used by the app
# itself. Download a service account key from:
#   Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Set this to the path of that downloaded JSON file. That file grants full
# admin access to your Firebase project — it must NEVER be committed; keep
# it outside the repo or make sure its filename matches one of the
# gitignored patterns in .gitignore.
SERVICE_ACCOUNT_PATH=
