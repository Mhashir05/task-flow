rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors the client's getMemberRole() fallback in boardsSlice.js: an
    // explicit roles map entry wins; otherwise the board owner defaults to
    // 'owner' and any other member defaults to 'member' (covers boards
    // created before the roles map existed, e.g. private boards, which
    // never get a roles map at all).
    function roleOf(board, uid) {
      return uid in board.get('roles', {})
        ? board.roles[uid]
        : (board.ownerId == uid
            ? 'owner'
            : (uid in board.members ? 'member' : null));
    }

    function isMember(board, uid) {
      return uid in board.members;
    }

    // Approximation of "admin added a new member, or removed an existing
    // PLAIN MEMBER, but did not reassign an existing member's role" — see
    // the note on the boards/update rule below for the remaining tradeoff
    // (a newly-ADDED entry's value can't be verified to be 'member').
    //
    // The removal half is tied to `members` shrinking by the SAME uid
    // (via the list-diff removeAll() pattern isSelfLeave already uses,
    // since `d.removedKeys()` is a Set and Sets have no index access in
    // this language — a List obtained from `members.removeAll(...)` does)
    // specifically so that uid's role BEFORE removal can be looked up and
    // checked. Without this, an admin could remove ANY single roles entry
    // — including the Owner's or another Admin's — since the original
    // version only counted key changes, never which uid or role they
    // belonged to. Requiring the members-array diff to match 1-for-1 with
    // the roles-key diff also closes a second, narrower gap: removing
    // just the roles key while leaving the uid in `members` would have
    // silently demoted them to 'member' via roleOf()'s own fallback,
    // without ever registering as a `changedKeys()` entry.
    function isSafeAdminRolesChange(before, after) {
      let d = after.get('roles', {}).diff(before.get('roles', {}));
      let removedMembers = before.members.removeAll(after.get('members', []));
      return d.changedKeys().size() == 0
        && (d.addedKeys().size() + d.removedKeys().size()) <= 1
        && (
          d.removedKeys().size() == 0
          || (
            removedMembers.size() == 1
            && d.removedKeys().hasOnly(removedMembers)
            && roleOf(before, removedMembers[0]) == 'member'
          )
        );
    }

    // A write that doesn't touch `field` at all is unaffected by this check;
    // a write that DOES touch it requires the actor's CURRENT role (from the
    // existing document) to be 'owner'. Used to make board rename Owner-only
    // (not Admin), independent of the roles-map gate above.
    function isOwnerOnlyFieldChange(before, after, uid, field) {
      return !after.diff(before).affectedKeys().hasAny([field])
        || roleOf(before, uid) == 'owner';
    }

    // Precise carve-out for ownership transfer: ownerId becomes some
    // existing member X, roles[X] becomes 'owner', roles[the OLD ownerId]
    // becomes 'admin', and NOTHING else in the document changes (not even
    // some OTHER member's role in the same write). Deliberately its own
    // function rather than folded into isSafeAdminRolesChange or
    // isOwnerOnlyFieldChange — this is a two-key roles change PLUS an
    // ownerId change, together, which neither of those shapes describes.
    // Gated on uid == before.ownerId (the CURRENT owner, pre-change) —
    // nobody else, including the incoming new owner, can initiate this.
    // roleOf(before, newOwner) == 'admin' mirrors transferOwnership's own
    // client-side check in boardsSlice.js: a plain Member must first be
    // promoted to Admin before they're eligible, so a direct Firestore
    // write can't bypass that same restriction.
    function isOwnershipTransfer(before, after, uid) {
      let newOwner = after.ownerId;
      let rolesDiff = after.get('roles', {}).diff(before.get('roles', {}));
      return uid == before.ownerId
        && newOwner != before.ownerId
        && newOwner in before.members
        && roleOf(before, newOwner) == 'admin'
        && after.diff(before).affectedKeys().hasOnly(['ownerId', 'roles'])
        && rolesDiff.addedKeys().size() == 0
        && rolesDiff.removedKeys().size() == 0
        && rolesDiff.changedKeys().hasOnly([before.ownerId, newOwner])
        && after.roles[newOwner] == 'owner'
        && after.roles[before.ownerId] == 'admin';
    }

    // A member voluntarily leaving: members shrinks by EXACTLY the acting
    // user's own uid (list.removeAll() proves this the same value-based way
    // isOwnCommentEdit/isCommentDelete already do on tasks — see there for
    // why that's the right tool), and roles loses exactly that uid's own
    // key — nothing else in the document changes. Blocked for the board's
    // ownerId specifically: the Owner must transferOwnership or
    // deleteCollaborativeBoard instead, never just disappear from `members`
    // while still being named as owner elsewhere in the document.
    function isSelfLeave(before, after, uid) {
      let beforeMembers = before.members;
      let afterMembers = after.get('members', []);
      let removedMembers = beforeMembers.removeAll(afterMembers);
      let addedMembers = afterMembers.removeAll(beforeMembers);
      let rolesDiff = after.get('roles', {}).diff(before.get('roles', {}));
      return uid != before.ownerId
        && after.diff(before).affectedKeys().hasOnly(['members', 'roles'])
        && removedMembers.size() == 1
        && removedMembers[0] == uid
        && addedMembers.size() == 0
        && rolesDiff.addedKeys().size() == 0
        && rolesDiff.changedKeys().size() == 0
        && rolesDiff.removedKeys().hasOnly([uid]);
    }

    match /boards/{boardId} {
      // The isMember branch covers queries filtered by
      // where('members', 'array-contains', uid) — Firestore can prove that
      // holds for every possible result directly from the query's own
      // filter. The ownerId branch exists because getUserPrivateBoard's
      // existing-board lookup filters by where('ownerId', '==', uid)
      // instead — a field the isMember check never references, so
      // Firestore can't verify isMember would hold for every possible
      // match and rejects the whole query, even though ownerId always
      // implies membership in this app's actual data. Firestore's query
      // validator doesn't trust that invariant — it only accepts a rule it
      // can prove straight from the query's declared filters, so ownerId
      // needs its own directly-provable branch.
      allow read: if isSignedIn()
        && (
          isMember(resource.data, request.auth.uid)
          || resource.data.ownerId == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members;

      // Any member may update the board EXCEPT the roles map. A roles
      // change is allowed if the actor's own CURRENT role (from the
      // existing document, not the incoming write) is 'owner' — full
      // access, including reassigning anyone between admin/member — OR if
      // it's an admin performing a single add-member/remove-member
      // (isSafeAdminRolesChange).
      //
      // Tradeoff: Firestore rules have no generic way to inspect the VALUE
      // of a dynamically-keyed added map entry without iteration, which
      // this language doesn't support. isSafeAdminRolesChange verifies an
      // admin's write touches at most one roles entry and does not modify
      // an EXISTING member's value, but it cannot verify that a newly
      // ADDED entry's value is specifically 'member' rather than 'admin'.
      // In practice this means a compromised or buggy admin client could
      // add a brand-new member directly as 'admin' (bypassing the
      // owner-only promotion path) in the same write that adds them to
      // members — but they still cannot touch any EXISTING member's role,
      // and cannot do this to more than one uid per write. Closing this
      // fully would require either a Cloud Function to validate the write,
      // or restructuring role assignment (e.g. new members always land as
      // 'member' via a server-controlled process) outside pure rules.
      allow update: if isSignedIn()
        && isMember(resource.data, request.auth.uid)
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles'])
          || roleOf(resource.data, request.auth.uid) == 'owner'
          || (
            roleOf(resource.data, request.auth.uid) == 'admin'
            && isSafeAdminRolesChange(resource.data, request.resource.data)
          )
          || isSelfLeave(resource.data, request.resource.data, request.auth.uid)
        )
        // Renaming (`name`) is Owner-only, independent of the roles gate
        // above — an Admin can still pass the roles branch (e.g. by not
        // touching `roles` at all) but is stopped here specifically for a
        // `name` change, since only that field is restricted by this clause.
        && isOwnerOnlyFieldChange(
             resource.data,
             request.resource.data,
             request.auth.uid,
             'name',
           )
        // ownerId may ONLY change via the precise isOwnershipTransfer shape
        // — deliberately NOT folded into the roles gate above. That gate's
        // unconditional "current owner can touch roles freely" branch would
        // otherwise let ownerId ride along with any roles write with zero
        // validation that the new owner is an actual member, that the old
        // owner is correctly demoted rather than orphaned, or that nothing
        // else in the document was tampered with in the same write.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])
          || isOwnershipTransfer(resource.data, request.resource.data, request.auth.uid)
        );

      // Owner-only — tightened from "any member" (isMember alone), which
      // let an Admin or Member delete a board out from under its owner.
      allow delete: if isSignedIn()
        && roleOf(resource.data, request.auth.uid) == 'owner';
    }

    match /tasks/{taskId} {
      function boardOfTask(boardId) {
        return get(/databases/$(database)/documents/boards/$(boardId)).data;
      }

      function isTaskBoardMember(boardId, uid) {
        return uid in boardOfTask(boardId).members;
      }

      // A member's comment write must add exactly one comment and leave
      // every existing one untouched. hasAll() proves nothing existing was
      // removed or altered; combined with the exact size-delta-of-1, that
      // proves it's a pure append rather than a same-length replacement.
      // (It does not strictly prove order was preserved, but a reorder
      // can't be used to tamper with or fabricate comment content, so
      // that's an acceptable gap, not a security hole.)
      function isMemberCommentAppend(before, after) {
        return after.diff(before).affectedKeys().hasOnly(['comments'])
          && after.comments.size() == before.get('comments', []).size() + 1
          && after.comments.hasAll(before.get('comments', []));
      }

      // A member's statusRequest write must go from null/absent to a new
      // request naming THEMSELVES as the requester (so they can't spoof a
      // request as coming from someone else) — never overwriting an
      // existing pending request. Clearing one back to null (approve or
      // reject) is owner/admin-only, via the role branch below.
      function isMemberStatusRequest(before, after) {
        return after.diff(before).affectedKeys().hasOnly(['statusRequest'])
          && before.get('statusRequest', null) == null
          && after.statusRequest != null
          && after.statusRequest.requestedBy == request.auth.uid;
      }

      // Editing exactly one comment's text, changing nothing else.
      // list.removeAll(list) is value-based (not index-based): it returns
      // the elements of the left list that are NOT present, by value,
      // anywhere in the right list. For a pure single-comment edit with
      // nothing else touched:
      //   - "removed" (before.removeAll(after)) is the one old comment
      //     object that no longer exists unchanged anywhere in `after`.
      //   - "added" (after.removeAll(before)) is the one new comment
      //     object that didn't exist unchanged anywhere in `before`.
      // Both must have exactly one element (proving only one entry
      // changed at all — editing two comments in one write, or any other
      // shape, fails this), and that pair must share uid/createdAt/email
      // with the acting user matching the ORIGINAL uid (so you can only
      // edit your own comment, and can't reassign a comment to a
      // different uid/createdAt/email while editing).
      function isOwnCommentEdit(before, after) {
        let beforeComments = before.get('comments', []);
        let afterComments = after.get('comments', []);
        let removed = beforeComments.removeAll(afterComments);
        let added = afterComments.removeAll(beforeComments);
        return after.diff(before).affectedKeys().hasOnly(['comments'])
          && beforeComments.size() == afterComments.size()
          && removed.size() == 1
          && added.size() == 1
          && removed[0].uid == request.auth.uid
          && added[0].uid == removed[0].uid
          && added[0].createdAt == removed[0].createdAt
          && added[0].email == removed[0].email;
      }

      // Deleting exactly one comment (array shrinks by exactly one, with
      // nothing added — ruling out a "remove one, add a different one"
      // swap dressed up as a delete). Allowed if the removed comment
      // belongs to the actor (self-delete), the actor is the board's
      // Owner (moderation of anyone, including their own — unrestricted),
      // or the actor is an Admin moderating someone who ISN'T the Owner.
      // An Admin can no longer delete the Owner's own comment — this is
      // NOT redundant with the unconditional owner/admin role branch in
      // allow update below the way the plain owner/admin case used to be:
      // isAdminDeletingOwnerComment there explicitly excludes exactly this
      // one shape from that blanket grant, so it's forced through here,
      // where an Admin now fails this check for the Owner's comments.
      function isCommentDelete(before, after, board, uid) {
        let beforeComments = before.get('comments', []);
        let afterComments = after.get('comments', []);
        let removed = beforeComments.removeAll(afterComments);
        let added = afterComments.removeAll(beforeComments);
        return after.diff(before).affectedKeys().hasOnly(['comments'])
          && beforeComments.size() == afterComments.size() + 1
          && removed.size() == 1
          && added.size() == 0
          && (
            removed[0].uid == uid
            || roleOf(board, uid) == 'owner'
            || (roleOf(board, uid) == 'admin' && roleOf(board, removed[0].uid) != 'owner')
          );
      }

      // The unconditional owner/admin branch in allow update below
      // normally covers comment deletion too — without this carve-out,
      // isCommentDelete's own owner/admin logic above would be completely
      // unreachable for that branch's actors (exactly the redundancy its
      // old comment used to note). This pulls exactly ONE shape out of
      // that blanket grant — an Admin deleting a comment authored by the
      // board's Owner — so it falls through to isCommentDelete's own
      // OR-arm instead, where it now correctly fails. Every other Admin
      // write (any other field, or deleting anyone else's comment) is
      // completely unaffected: this only returns true for that one exact
      // shape, mirrored against isCommentDelete's own detection so the
      // two functions can never disagree about what counts as a comment
      // delete.
      function isAdminDeletingOwnerComment(before, after, board, uid) {
        let beforeComments = before.get('comments', []);
        let afterComments = after.get('comments', []);
        let removed = beforeComments.removeAll(afterComments);
        return roleOf(board, uid) == 'admin'
          && after.diff(before).affectedKeys().hasOnly(['comments'])
          && beforeComments.size() == afterComments.size() + 1
          && removed.size() == 1
          && roleOf(board, removed[0].uid) == 'owner';
      }

      // The board's Owner must never appear as a task assignee — not
      // enforceable by content-checking `assignees` directly, since it's a
      // List<Map> and this language's List operations (hasAny/hasAll/
      // hasOnly) only do whole-element equality; there's no per-field
      // predicate (no .exists()/.filter() comprehension here) to ask "does
      // any element have uid == X" against a list of {uid, email} maps.
      // `assigneeUids` (a plain string array, derived from `assignees` in
      // the SAME write by setTaskAssignees in tasksSlice.js) exists
      // specifically to make this checkable — hasAny() works directly on
      // scalars. `assigneeUids` is therefore the SOLE rules-enforced
      // source of truth for this restriction; `assignees` itself carries
      // no independent guarantee here. Keeping the two in lockstep is a
      // client-trusted invariant, the same trust boundary as boardId/type
      // consistency elsewhere in this schema — nothing in this file
      // verifies `assignees` and `assigneeUids` actually describe the same
      // set of people, only that neither the Owner's uid specifically ends
      // up in `assigneeUids`.
      //
      // `after.get('assigneeUids', [])` defaults a legacy task that has
      // never had this field written to an empty list, so this returns
      // true (not applicable) — never blocking an unrelated update to an
      // old task — both when `assigneeUids` isn't touched at all AND, via
      // the default, if it somehow were read without ever being written.
      function isSafeAssigneeUids(before, after, board) {
        return !after.diff(before).affectedKeys().hasAny(['assigneeUids'])
          || !after.get('assigneeUids', []).hasAny([board.ownerId]);
      }

      // A private/collaborative move requires BOTH: (a) creator-only,
      // regardless of role — even an Owner/Admin must not be able to
      // relocate a task someone else created — AND (b) the actor must hold
      // owner/admin role on the TARGET board (after.boardId), not just the
      // current one.
      //
      // (b) closes a gap found while adding the publish-request workflow:
      // without it, a private board's owner (always also its own tasks'
      // creator, satisfying (a) trivially) could set boardId directly to
      // ANY board — including one where their own role is only 'member' —
      // completely bypassing the requestPublish/approve flow that's
      // supposed to gate exactly that case.
      //
      // Trigger vs. shape are deliberately separate checks — hasAny(...)
      // decides whether this function applies AT ALL (any write that
      // touches boardId, however it's bundled), while hasOnly(...) is one
      // of the things the approved shape must satisfy. An earlier version
      // collapsed both into a single hasOnly(['boardId']) check, which
      // made the function vacuously return true — skipping (a) and (b)
      // entirely — for any write that touched boardId ALONGSIDE some other
      // field (e.g. {boardId, title} in the same write): affectedKeys()
      // then had more than just 'boardId' in it, hasOnly(['boardId'])
      // was false, and `!false` made the whole function true. That let an
      // Owner/Admin of the CURRENT board relocate any task — including one
      // they didn't create, to a board they hold no role on at all — just
      // by bundling a trivial edit to any other field alongside boardId.
      // Now, ANY write touching boardId must satisfy the full (a)+(b)
      // check, bundled or not — there is no longer a bundling escape.
      //
      // A write not touching boardId at all is unaffected (hasAny is
      // false, so `!false` makes the function true) and falls through to
      // the normal owner/admin / member-carve-out branches below as usual.
      // This does NOT apply to isPublishApprove below — that branch is a
      // completely separate grant for the TARGET board's Owner, who by
      // definition isn't isTaskBoardMember of the current board at all, so
      // this function (scoped inside that AND-group) never runs for them;
      // isPublishApprove has its own, independent correctness checks.
      function isSafeBoardMove(before, after, uid) {
        let affected = after.diff(before).affectedKeys();
        return !affected.hasAny(['boardId'])
          || (
            affected.hasOnly(['boardId'])
            && before.userId == uid
            && roleOf(
                 get(/databases/$(database)/documents/boards/$(after.boardId)).data,
                 uid
               ) in ['owner', 'admin']
          );
      }

      // The corresponding OR-branch grant: a plain Member (not owner/admin)
      // moving a task THEY created between private/collaborative. Without
      // this, a Member's boardId-only write matches no branch above (none
      // of the other member carve-outs mention boardId) and would be
      // rejected outright — including for their own task. Combined with
      // isSafeBoardMove's restriction below, the net effect is: creator-only,
      // for every role, exactly as intended.
      function isCreatorBoardMove(before, after, uid) {
        return after.diff(before).affectedKeys().hasOnly(['boardId'])
          && before.userId == uid;
      }

      // A Member's direct status change on a task THEY created — exactly
      // one field (status) touched, no approval detour needed. Owner/Admin
      // already have unrestricted status control on any task via the role
      // branch below regardless of creator, so this exists purely to grant
      // the creator-Member case the role branch doesn't cover.
      //
      // after.status != 'Done' additionally excludes 'Done' as a target
      // this carve-out can ever produce — a Member's own-task status write
      // must land in Review, To Do, or In Progress, never Done directly;
      // only Owner/Admin (the unconditional role branch above/below, never
      // gated by this function at all) may set Done. BoardWorkspace.jsx's
      // handleStatusChange already substitutes 'Review' for 'Done' before
      // ever dispatching on a Member's behalf, so a legitimate Member
      // action never actually attempts this write in practice — this is
      // the independent rules-layer boundary behind that UI substitution,
      // the same two-layer pattern as every other member-facing
      // restriction in this file.
      function isCreatorStatusChange(before, after, uid) {
        return after.diff(before).affectedKeys().hasOnly(['status'])
          && before.userId == uid
          && after.status != 'Done';
      }

      // A Member/Admin's delete request — same null-to-value, self-only
      // shape as isMemberStatusRequest above, just for a different field.
      // Clearing it back to null (reject) or performing the real delete
      // (approve) are both Owner-only, enforced by the role branch below
      // (reject, a plain field write) and the dedicated `allow delete` rule
      // (approve, an actual document delete) respectively — neither goes
      // through this function.
      function isRequestDeleteChange(before, after, uid) {
        return after.diff(before).affectedKeys().hasOnly(['deleteRequest'])
          && before.get('deleteRequest', null) == null
          && after.deleteRequest != null
          && after.deleteRequest.requestedBy == uid;
      }

      // The TARGET board's Owner is, by definition, generally NOT a member
      // of the task's current board (its requester's private board) — so
      // isTaskBoardMember alone would lock them out of even reading the
      // task to decide on it. This grants read access specifically when a
      // pending publishRequest names a board this uid owns. The extra
      // get() here is the one described in the PR: one additional read
      // per rule evaluation, on top of isTaskBoardMember's own get().
      function isPublishTargetOwner(task, uid) {
        return task.get('publishRequest', null) != null
          && roleOf(
               get(/databases/$(database)/documents/boards/$(task.publishRequest.targetBoardId)).data,
               uid
             ) == 'owner';
      }

      // Approve: boardId becomes EXACTLY the board named in the pending
      // request, and publishRequest clears to null, in the SAME write —
      // both conditions together prove the task actually lands on the
      // board the request named (not some other value the approving owner
      // might substitute), and that the request doesn't linger stale
      // afterward. Deliberately == 'owner', not in ['owner','admin'] — the
      // spec is explicit that only the target board's OWNER reviews these,
      // unlike every other Owner/Admin-unified check in this file.
      function isPublishApprove(before, after, uid) {
        return before.get('publishRequest', null) != null
          && after.diff(before).affectedKeys().hasOnly(['boardId', 'publishRequest'])
          && after.boardId == before.publishRequest.targetBoardId
          && after.get('publishRequest', null) == null
          && roleOf(
               get(/databases/$(database)/documents/boards/$(before.publishRequest.targetBoardId)).data,
               uid
             ) == 'owner';
      }

      // Reject: ONLY publishRequest clears to null — boardId must be
      // untouched (hasOnly(['publishRequest']), not the two-field list
      // approve allows), so the task stays exactly where it was.
      function isPublishReject(before, after, uid) {
        return before.get('publishRequest', null) != null
          && after.diff(before).affectedKeys().hasOnly(['publishRequest'])
          && after.get('publishRequest', null) == null
          && roleOf(
               get(/databases/$(database)/documents/boards/$(before.publishRequest.targetBoardId)).data,
               uid
             ) == 'owner';
      }

      allow read: if isSignedIn()
        && (
          isTaskBoardMember(resource.data.boardId, request.auth.uid)
          || isPublishTargetOwner(resource.data, request.auth.uid)
        );

      // Owner-only-direct, on ANY task regardless of who created it —
      // Admin and Member (even the task's own creator) must go through
      // requestDelete/approveDeleteRequest instead. roleOf()'s fallback
      // (ownerId == uid -> 'owner') already makes this work correctly for a
      // private board's sole member with no extra code: they're always
      // 'owner' there, so their own direct deletes are unaffected.
      //
      // Confirmed unchanged/not duplicated for deleteCollaborativeBoard's
      // cascade: the acting user is that board's Owner, so
      // roleOf(boardOfTask(theirOwnBoardId), uid) == 'owner' is already
      // true for every task under it — this rule already permits deleting
      // all of them, with no loosening needed.
      allow delete: if isSignedIn()
        && isTaskBoardMember(resource.data.boardId, request.auth.uid)
        && roleOf(boardOfTask(resource.data.boardId), request.auth.uid) == 'owner';

      allow create: if isSignedIn()
        && isTaskBoardMember(request.resource.data.boardId, request.auth.uid);

      // Owner/admin: full access to any field (status changes, editing,
      // approving/rejecting a status or delete request, task assignment,
      // etc.) on ANY task — same as before this feature. Plain member:
      // restricted to EXACTLY one of the safe shapes above (comment append/
      // edit/delete, a status-request, a creator-only boardId move, a
      // creator-only direct status change, or a delete request); every
      // other field (title, description, assignees, ...) — and status/
      // boardId/deleteRequest changes OUTSIDE those specific shapes — is
      // off-limits to them entirely. Because affectedKeys() only contains
      // fields whose VALUE actually changed, a member cannot bundle a real
      // change into an otherwise-allowed write: doing so adds an extra key
      // to affectedKeys(), which fails every hasOnly([...]) check
      // immediately — there is no shape of request that changes an
      // off-limits field and still satisfies a member branch. This is why
      // `assignees` needed no rule of its own: it's Owner/Admin-only
      // automatically, simply by never being named in any member carve-
      // out's hasOnly() list. Private boards are unaffected: a private
      // board's sole member has no roles map, and roleOf()'s fallback
      // resolves ownerId == uid to 'owner', so they always take the
      // unrestricted branch. This also covers the requester's own creation
      // of publishRequest (null -> value) on their own private task without
      // needing any dedicated carve-out: a private board's sole member is
      // always 'owner' there via that same fallback, so the unconditional
      // owner/admin branch already grants it, and isSafeBoardMove doesn't
      // apply since affectedKeys() is ['publishRequest'], not ['boardId'].
      //
      // The publish-approval branches below are a SEPARATE top-level OR,
      // outside this whole isTaskBoardMember-gated group — deliberately.
      // The target board's Owner reviewing a request is, by definition,
      // generally not a member of the task's CURRENT board (the requester's
      // private board) at all, so isTaskBoardMember(resource.data.boardId,
      // uid) would be false for them and reject the write before ever
      // reaching an OR-chain nested inside it. isPublishApprove/
      // isPublishReject are fully self-contained (they independently prove
      // the actor owns the referenced target board), so they don't need —
      // and must not be gated by — isTaskBoardMember or isSafeBoardMove.
      allow update: if isSignedIn()
        && (
          (
            isTaskBoardMember(resource.data.boardId, request.auth.uid)
            && (
              (
                roleOf(boardOfTask(resource.data.boardId), request.auth.uid) in ['owner', 'admin']
                && !isAdminDeletingOwnerComment(
                     resource.data,
                     request.resource.data,
                     boardOfTask(resource.data.boardId),
                     request.auth.uid
                   )
              )
              || isMemberCommentAppend(resource.data, request.resource.data)
              || isMemberStatusRequest(resource.data, request.resource.data)
              || isOwnCommentEdit(resource.data, request.resource.data)
              || isCommentDelete(
                   resource.data,
                   request.resource.data,
                   boardOfTask(resource.data.boardId),
                   request.auth.uid
                 )
              || isCreatorBoardMove(resource.data, request.resource.data, request.auth.uid)
              || isCreatorStatusChange(resource.data, request.resource.data, request.auth.uid)
              || isRequestDeleteChange(resource.data, request.resource.data, request.auth.uid)
            )
            // Independent of every branch in the group above — including
            // the unconditional owner/admin one — so a private/
            // collaborative move specifically still requires being the
            // task's creator AND holding owner/admin on the target board,
            // no matter what role otherwise would have allowed this write.
            && isSafeBoardMove(resource.data, request.resource.data, request.auth.uid)
            // Same independence as isSafeBoardMove above, for a different
            // field: no branch in the group — including the unconditional
            // owner/admin one — may write the board's Owner into
            // assigneeUids, regardless of what role or shape otherwise
            // permitted this write. In practice only the unconditional
            // owner/admin branch can touch assigneeUids at all today (no
            // member carve-out's hasOnly() names it), but this is applied
            // at the group level rather than folded into that one branch
            // so it stays correct even if a future carve-out ever did.
            && isSafeAssigneeUids(
                 resource.data,
                 request.resource.data,
                 boardOfTask(resource.data.boardId),
               )
          )
          || isPublishApprove(resource.data, request.resource.data, request.auth.uid)
          || isPublishReject(resource.data, request.resource.data, request.auth.uid)
        );
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // Public lookup table so a non-member can resolve an invite code to a
    // boardId without needing read access to the board itself (boards are
    // member-only readable, above). Written only at board-creation time by
    // createCollaborativeBoard.
    match /inviteCodes/{code} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && roleOf(
             get(/databases/$(database)/documents/boards/$(request.resource.data.boardId)).data,
             request.auth.uid
           ) == 'owner';

      allow update, delete: if isSignedIn()
        && roleOf(
             get(/databases/$(database)/documents/boards/$(resource.data.boardId)).data,
             request.auth.uid
           ) == 'owner';
    }

    match /joinRequests/{requestId} {
      function boardOf(boardId) {
        return get(/databases/$(database)/documents/boards/$(boardId)).data;
      }

      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid;

      allow read: if isSignedIn()
        && (
          resource.data.requesterUid == request.auth.uid
          || roleOf(boardOf(resource.data.boardId), request.auth.uid) in ['owner', 'admin']
        );

      allow update: if isSignedIn()
        && roleOf(boardOf(resource.data.boardId), request.auth.uid) in ['owner', 'admin'];

      // Previously missing entirely — needed so deleteCollaborativeBoard's
      // cascade can clean up a deleted board's joinRequests. Scoped to
      // that board's Owner/Admin, consistent with who can already
      // read/update join requests for it above.
      allow delete: if isSignedIn()
        && roleOf(boardOf(resource.data.boardId), request.auth.uid) in ['owner', 'admin'];
    }

    // Mirrors joinRequests above, for the opposite direction: a plain
    // Member requesting to leave a board rather than requesting to join
    // one. Admins/Owners never create one of these — they leave/remove
    // directly (leaveBoard / deleteCollaborativeBoard / removeMember),
    // enforced here by requiring the requester's CURRENT role to be
    // exactly 'member'.
    match /leaveRequests/{requestId} {
      function boardOf(boardId) {
        return get(/databases/$(database)/documents/boards/$(boardId)).data;
      }

      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && roleOf(boardOf(request.resource.data.boardId), request.auth.uid) == 'member';

      allow read: if isSignedIn()
        && (
          resource.data.requesterUid == request.auth.uid
          || roleOf(boardOf(resource.data.boardId), request.auth.uid) in ['owner', 'admin']
        );

      // Covers both approve and reject — approve's actual membership
      // removal happens as a separate write to boards/{boardId}, already
      // covered by that document's own allow update rule (see
      // approveLeaveRequest in leaveRequestsSlice.js: the diff shape is
      // identical to removeMember's, which the existing owner/
      // isSafeAdminRolesChange branches already permit — no new carve-out
      // needed there).
      allow update: if isSignedIn()
        && roleOf(boardOf(resource.data.boardId), request.auth.uid) in ['owner', 'admin'];
    }
  }
}
